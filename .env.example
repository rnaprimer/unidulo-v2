# Copy to .env.local for local work. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# Supabase (new project). The service-role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. The site key is public; the secret key is not.
# In production, submissions are refused if the secret key is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend, for the alert email sent to the owner on each submission.
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# The owner's console at /ops. This is the User UID of the one Supabase Auth
# user allowed in (Supabase > Authentication > Users). Not a secret, but if it
# is missing or wrong nobody can sign in. Server only: no NEXT_PUBLIC_ prefix.
OWNER_USER_ID=

# Any long random string. Used to scramble IP addresses for rate limiting.
IP_HASH_SALT=

# Optional. Shown on the contact page if set.
NEXT_PUBLIC_CONTACT_EMAIL=
